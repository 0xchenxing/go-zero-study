syntax = "v1"

type (
	LoginReq {
		Username string `json:"username"`
		Password string `json:"password"`
	}
	LoginResp {
		AccessToken  string `json:"accessToken"`
		RefreshToken string `json:"refreshToken"`
		ExpiresIn    int64  `json:"expiresIn"`
	}
	LogoutResp {
		Success bool   `json:"success"`
		Message string `json:"message,omitempty"`
	}
	RefreshReq {
		RefreshToken string `json:"refreshToken"`
	}
	ProfileReq {
		UserId int64 `path:"userId"`
	}
	ProfileResp {
		UserId   int64  `json:"userId"`
		Username string `json:"username"`
		Role     string `json:"role"`
	}
	UpdateProfileReq {
		UserId   int64  `path:"userId"`
		Username string `json:"username"`
	}
	UpdateProfileResp {
		Success bool `json:"success"`
	}
	UserInfoReq {
		Id int64 `path:"id"`
	}
	UserInfoResp {
		Id       int64  `json:"id"`
		Username string `json:"username"`
		Email    string `json:"email"`
	}
	UserUpdateReq {
		Id       int64  `path:"id"`
		Username string `json:"username"`
		Email    string `json:"email"`
	}
	UserUpdateResp {
		Info string `json:"info"`
	}
	SseReq {
		Body string `json:"body"`
	}
	SseResp {
		Msg string `json:"msg"`
	}
	UploadResp {
		Filename string `json:"filename"`
		Size     int64  `json:"size"`
		URL      string `json:"url"`
	}
	CreateUserReq {
		Username string `json:"username"`
		Email    string `json:"email"`
		Password string `json:"password"`
	}
	CreateUserResp {
		Id int64 `json:"id"`
	}
	CreateUserWithTodoReq {
		Username  string `json:"username"`
		Email     string `json:"email"`
		Password  string `json:"password"`
		TodoTitle string `json:"todoTitle"`
	}
	CreateUserWithTodoResp {
		UserId    int64  `json:"userId"`
		Username  string `json:"username"`
		Email     string `json:"email"`
		TodoId    int64  `json:"todoId"`
		TodoTitle string `json:"todoTitle"`
	}
	RollbackDemoResp {
		Message string `json:"message"`
	}
)

service user-api {
	@handler Login
	post /user/login (LoginReq) returns (LoginResp)

	@handler RefreshToken
	post /user/refresh (RefreshReq) returns (LoginResp)

	@handler GetUserInfo
	get /user/:id (UserInfoReq) returns (UserInfoResp)

	@handler UploadFile
	post /upload/file returns (UploadResp)

	// 场景 B：新增用户。重复账号命中唯一索引，返回 409 业务错误。
	@handler CreateUser
	post /users (CreateUserReq) returns (CreateUserResp)

	// 场景 A：单个事务内创建用户 + 待办，任一步失败整体回滚。
	@handler CreateUserWithTodo
	post /users-with-todo (CreateUserWithTodoReq) returns (CreateUserWithTodoResp)

	// 场景 A 的回滚演示：第二步故意违反外键，验证用户不会残留。
	@handler CreateUserWithTodoRollbackDemo
	post /users-with-todo/rollback-demo (CreateUserWithTodoReq) returns (RollbackDemoResp)
}

@server (
	sse: true
)
service user-api {
	@handler sse
	post /sse/with/req (SseReq) returns (SseResp)

	@handler sseresp
	post /sse/without/resp returns (*SseResp)
}

// 受保护接口：jwt: Auth 启用 Token 验证中间件。
// Auth 对应 YAML 配置文件中的 JWT 配置键。
@server (
	jwt:        Auth
	middleware: JwtBlacklist
)
service user-api {
	@handler UpdateUserInfo
	post /user/:id (UserUpdateReq) returns (UserUpdateResp)

	@handler GetProfile
	get /user/profile/:userId (ProfileReq) returns (ProfileResp)

	@handler UpdateProfile
	put /user/profile/:userId (UpdateProfileReq) returns (UpdateProfileResp)

	@handler Logout
	post /user/logout returns (LogoutResp)
}
